\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Dynamic Window Modulation Mechanism: Illustration of dynamic window adaptation: during stationary low-volatility regimes, the window expands to 5 points for maximum noise smoothing; during sudden trend inflections, the window contracts to 1 point to eliminate phase lag.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig2}{{2}{4}{Dynamic Window Modulation Mechanism: Illustration of dynamic window adaptation: during stationary low-volatility regimes, the window expands to 5 points for maximum noise smoothing; during sudden trend inflections, the window contracts to 1 point to eliminate phase lag}{figure.2}{}}
